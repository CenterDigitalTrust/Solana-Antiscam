# Solana Meme Research Lab - Environment Configuration Template
# DO NOT COMMIT REAL KEYS TO GIT

# Helius RPC & DAS API (Required for on-chain checks)
HELIUS_API_KEY=

# Birdeye DeFi API (Required for granular market stats & historical OHLCV)
BIRDEYE_API_KEY=

# Jupiter API (Optional - for advanced quote probing and routing)
JUPITER_API_KEY=

# Database configuration (Defaults to SQLite in data/research_lab.db)
DATABASE_PATH=data/research_lab.db

# Feature Storage Path (Parquet time-series)
FEATURE_STORE_PATH=data/features.parquet

# Simulation Defaults
SIMULATION_STARTING_CAPITAL=100.0
SIMULATION_POSITION_SIZE=2.0
SIMULATION_MAX_POSITIONS=50
SIMULATION_DEFAULT_STOP_LOSS_PCT=25.0
SIMULATION_DEFAULT_TAKE_PROFIT_PCT=50.0

# Polling Interval Priorities (in seconds)
POLL_INTERVAL_HOT=10
POLL_INTERVAL_WATCH=30
POLL_INTERVAL_COLD=180
